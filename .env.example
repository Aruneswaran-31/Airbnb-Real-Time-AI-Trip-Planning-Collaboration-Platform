# ---------------------------------------------------------------------------
# Trip War Room — environment template. Copy to server/.env and fill in.
# Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# MongoDB. Leave blank in development to use the bundled zero-install MongoDB
# (persisted under server/.data/mongo). Set it for a real deployment, e.g.
#   MONGODB_URI=mongodb://localhost:27017/trip_war_room
MONGODB_URI=
MONGODB_DB=trip_war_room

# JWT signing keys. REQUIRED in production; dev defaults are provided otherwise.
# Generate strong values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=45m
JWT_REFRESH_TTL=7d

# AI Concierge. Optional: without a key the concierge runs its deterministic,
# data-grounded generator. With a key it uses any OpenAI-compatible endpoint.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=3500

# Constraint engine defaults (PRD 6.2)
DEFAULT_RADIUS_KM=2
DEFAULT_HOURS_BUFFER_MINUTES=30

LOG_LEVEL=info

# Web client (Vite). Only needed in web/.env if the API is not on :4000.
# The browser always calls same-origin /api and /socket.io; Vite proxies them.
# VITE_API_URL=http://localhost:4310
# VITE_PORT=5173
